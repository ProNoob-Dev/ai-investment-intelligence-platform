# ─── LLM providers ──────────────────────────────────────────────────────────
# Inception Labs (Mercury) is the live provider. Get a key at
# https://api.inceptionlabs.ai — OpenAI-compatible, base URL below.
INCEPTION_API_KEY=
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
INCEPTION_MODEL=mercury-3

# Gemini is the second provider / fallback. Get a key at https://aistudio.google.com
GOOGLE_API_KEY=

# Primary provider: inception (default) or gemini
LLM_PROVIDER=inception

# Optional: full LLM analysis path instead of the deterministic fast path
USE_GENAI_ANALYSIS=false
ENABLE_AI_SUMMARY=true

# ─── Data ───────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
CHROMA_COLLECTION_NAME=market_news_v2

# ─── Live news ──────────────────────────────────────────────────────────────
# RSS feeds are free and need no key. NewsAPI / Finnhub are optional.
LIVE_NEWS_ENABLED=true
LIVE_NEWS_PROVIDER=newsapi,rss
NEWSAPI_KEY=
FINNHUB_API_KEY=
FINNHUB_NEWS_CATEGORY=general
NEWS_QUERY=(India OR Indian) AND (NSE OR BSE OR Sensex OR Nifty OR RBI OR SEBI OR earnings OR stocks OR equities OR banks)
LIVE_NEWS_INTERVAL_MINUTES=30
LIVE_NEWS_LOOKBACK_HOURS=24
LIVE_NEWS_PAGE_SIZE=50
LIVE_NEWS_MAX_ARTICLES_PER_RUN=100
USE_SECTOR_ROTATION=true
USE_INDIA_DOMAINS=true
RSS_ENABLED=true

# ─── Analysis tuning ────────────────────────────────────────────────────────
FAST_NEWS_MAX_AGE_DAYS=30
FAST_NEWS_MAX_CANDIDATES=120

# ─── Server ─────────────────────────────────────────────────────────────────
# Comma-separated origins, or * for cloud deployment
ALLOWED_ORIGINS=
# Set to require X-Admin-Key on /admin/* endpoints
ADMIN_API_KEY=
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=60
